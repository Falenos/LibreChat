# knauf/code-adapter — local development template.
# In-cluster, all of this arrives via GitOps values (ConfigMap/ExternalSecret);
# the AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_FEDERATED_TOKEN_FILE trio is
# injected by the workload-identity webhook and must never be set by hand.

# Local dev: skip JWT verification (synthetic local user). Refuses to start
# with NODE_ENV=production.
CODE_ADAPTER_LOCAL_MODE=true

PORT=3112
LOG_LEVEL=debug

# --- ACA session pool (from the sandbox-subscription spike or agk-infrastructure outputs)
# ONE code-interpreter (PythonLTS) pool serves everything — it has bash + python3
# + pandas/numpy/matplotlib, so both lang=py and lang=bash route here.
ACA_POOL_ENDPOINT=https://<region>.dynamicsessions.io/subscriptions/<sub>/resourceGroups/<rg>/sessionPools/<pool>
# Pinned data-plane api-version; bump deliberately and refresh
# test/fixtures/aca/ + acaShape.spec.ts together.
ACA_API_VERSION=2024-02-02-preview

# --- Stores (locally: Azurite or a developer-owned storage account)
BLOB_CONTAINER=code-adapter-staging
TABLE_NAME=codeAdapterFiles

# Table auth is intentionally stricter than Blob auth. In-cluster, use the adapter's
# workload identity and a table-scoped Storage Table Data Contributor assignment:
# AZURE_TABLE_ACCOUNT_NAME=agkstoragedev
# AZURE_TABLE_ACCOUNT_URL=https://agkstoragedev.table.core.windows.net
#
# A Table connection string is accepted only with CODE_ADAPTER_LOCAL_MODE=true.
AZURE_TABLE_CONNECTION_STRING=UseDevelopmentStorage=true

# Blob auth is ONE-OF. Prefer workload identity in-cluster: set the account name and the pod
# uses the same federated identity it already holds for ACA, so its reach is exactly its role
# assignments (scope `Storage Blob Data Contributor` to the code-adapter-staging container).
# AZURE_STORAGE_ACCOUNT_NAME=agkstoragedev
# AZURE_STORAGE_ACCOUNT_URL=https://agkstoragedev.blob.core.windows.net   # or spell it out
#
# The connection string is the fallback, and locally the easy path (Azurite). Note what it is
# in AGK: `agentic-karl-BLOB-STORAGE-CONNECTION-STRING` holds the storage account PRIMARY KEY,
# which grants every container on the account including the app's own `files`. Workload
# identity wins when both are set, so migrating away from it is order-independent.
AZURE_STORAGE_CONNECTION_STRING=

# --- Inbound JWT verification (unused in LOCAL_MODE; prod gets these from values)
# CODEAPI_JWT_PUBLIC_KEY=            # SPKI PEM (public half of AGK-CODEAPI-JWT-PRIVATE-KEY)
# CODEAPI_JWT_ALLOWED_ALGS=EdDSA
# CODEAPI_JWT_ISSUER=agentic-karl
# CODEAPI_JWT_AUDIENCE=codeapi
# CODEAPI_JWT_KID=lc-codeapi-dev-2026-08

# --- Session ids. Keys the owner tag every session id carries AND the derivation of a
# session id from `runtime_session_hint` (src/validate.ts). Ownership holds even if this is
# public, so the JWT public key is an acceptable default; set a real secret before enabling
# `toolExecution.sandbox.statefulSessions`, or a known conversation id yields a predictable
# session id. The adapter warns at boot when this is unset.
# SESSION_HINT_SECRET=

# --- One-off Mongo-to-Table migration only; the normal runtime ignores these.
# MONGO_URI=
# MONGO_DB=code_adapter
# MONGO_FILES_COLLECTION=code_adapter_files
# MIGRATION_APPLY=false              # writes require exactly true; false validates only
# MIGRATION_MAX_DOCUMENTS=100000
# MIGRATION_BATCH_SIZE=100

# --- Tuning (defaults shown)
# EXEC_WRAPPER=full                  # off = verbatim code + 0/1 exit synthesis + ~4000-char cap
# ACA_EXEC_TIMEOUT_MS=230000
# STDOUT_MAX_BYTES=65536
# UPLOAD_MAX_BYTES=134217728
# CAPTURE_MAX_FILES=20               # also caps files per /upload/batch request
# CAPTURE_MAX_TOTAL_BYTES=268435456  # supported total generated-file capture per execution
# CAPTURE_MAX_TOTAL_MS=60000         # wall-clock ceiling on post-exec capture
# FILE_TTL_HOURS=24
# REAPER_INTERVAL_MS=3600000         # orphaned-blob sweep (src/store/reaper.ts)
# REAPER_LEASE_MS=120000             # short renewable single-runner Table lease
# RECONCILIATION_INTERVAL_MS=86400000
# RECONCILIATION_PAGE_SIZE=100
# RECONCILIATION_MAX_PAGES=10
# RECONCILIATION_MAX_MS=30000
# CLEANUP_ENABLED=true               # set false only for a dark pre-cutover validation pod
