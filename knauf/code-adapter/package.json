{
  "name": "@knauf/code-adapter",
  "version": "0.3.2",
  "private": true,
  "description": "Tier-3 adapter: LibreChat Code API -> Azure Container Apps dynamic session pools (KARL code execution backend)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "probe:table": "node scripts/probe-table-storage.mjs"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "multer": "^2.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
