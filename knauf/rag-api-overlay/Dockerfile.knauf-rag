# [knauf] RAG API overlay — adds Azure AI Document Intelligence as the parser for
# file-search (RAG) ingestion, so scanned / image-based PDFs become searchable
# markdown instead of empty text. Tier-2 overlay pattern (same idea as Dockerfile.knauf).
#
# The vendored document_loader.py was extracted from this exact base image and carries
# one additive [knauf] branch in get_loader(). When bumping the base tag, re-extract the
# upstream file and re-apply that branch (see README.md in this directory).
#
# NOTE: pin to a digest (...@sha256:...) for prod. :latest is used locally to match the
# image the compose stack already pulls.
FROM registry.librechat.ai/danny-avila/librechat-rag-api-dev-lite:latest

# Azure Document Intelligence SDK. The langchain loader class ships with
# langchain-community, but the underlying SDK is not bundled in the base image.
RUN pip install --no-cache-dir "azure-ai-documentintelligence>=1.0.0"

# Overlay the patched loader (vendored upstream file + one additive Azure DI branch).
COPY document_loader.py /app/app/utils/document_loader.py
